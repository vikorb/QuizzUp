# Construit l'espace centre (backoffice/frontend) et l'écran de salle (game/room-app) en fichiers
# statiques. L'image finale ne sert à rien d'autre qu'à les copier dans le volume `static` :
# c'est Caddy (Dockerfile.caddy) qui les sert. Contexte de build : la racine du dépôt.

FROM node:22-alpine AS build
# URL de l'API, figée dans les fichiers à la construction (changer de nom d'hôte = reconstruire).
ARG API_URL
ENV VITE_API_URL=${API_URL}
WORKDIR /repo

# Constantes partagées (construites pour le backoffice, en sources pour la salle).
COPY backoffice/shared backoffice/shared
RUN npm --prefix backoffice/shared ci && npm --prefix backoffice/shared run build

# Espace centre
COPY backoffice/frontend/package*.json backoffice/frontend/
RUN npm --prefix backoffice/frontend ci
COPY backoffice/frontend backoffice/frontend
COPY backoffice/tsconfig*.json backoffice/
RUN npm --prefix backoffice/frontend run build-only

# Écran de salle (moteur, matériel et audio en sources via les alias Vite)
COPY game/room-app/package*.json game/room-app/.npmrc game/room-app/
RUN npm --prefix game/room-app ci
COPY game/engine/src game/engine/src
COPY game/hardware/src game/hardware/src
COPY game/audio/src game/audio/src
COPY game/room-app game/room-app
RUN npm --prefix game/room-app run build

FROM alpine:3
COPY --from=build /repo/backoffice/frontend/dist /dist/app
COPY --from=build /repo/game/room-app/dist /dist/salle
# Dossier de destination au bon propriétaire : le volume nommé en hérite (utilisateur non root).
RUN mkdir -p /srv/web && chown 65532:65532 /srv/web
USER 65532:65532
