# Production QuizzUP. Copier en `.env` (jamais versionné, `chmod 600 .env`), puis remplir.
# Les lignes vides ci-dessous sont OBLIGATOIRES : `docker compose` refuse de démarrer tant
# qu'elles ne sont pas remplies. Aucune valeur par défaut faible n'existe.
# Générer un secret : openssl rand -hex 32  (hexadécimal : pas de caractère spécial, le mot de
# passe de la base est inséré tel quel dans une URL).

# --- Version déployée -------------------------------------------------------------------------
# Tag git de la version en place. Première installation : le tag à déployer (ex. v1.0.0).
# Ensuite, c'est update.sh qui met cette ligne à jour : ne plus y toucher.
QUIZZUP_VERSION=

# --- Noms d'hôte : un par surface ------------------------------------------------------------
# Chacun doit avoir un enregistrement DNS vers le serveur (voir README, « DNS attendu »).
# Noms complets, sans https:// (ex. www.example.org).
HOST_WWW=
HOST_APP=
HOST_SALLE=
HOST_API=
# Console éditeur : nom d'hôte séparé, à ne pas communiquer.
HOST_CONSOLE=

# Adresse e-mail déclarée auprès de l'autorité de certification (avis d'expiration).
ACME_EMAIL=

# --- Site vitrine ----------------------------------------------------------------------------
# true : www sert le dossier VITRINE_DIR. false : www renvoie vers l'espace centre.
VITRINE_ENABLED=false
# Dossier des fichiers statiques de la vitrine (chemin absolu, ou relatif à ce dossier).
# VITRINE_DIR=./vitrine

# --- Réseau ----------------------------------------------------------------------------------
# Plages autorisées pour la console éditeur et Swagger : CIDR séparés par des espaces
# (ex. 203.0.113.0/24 198.51.100.7/32). VIDE = accès refusé à tout le monde.
EDITOR_ALLOWED_RANGES=
# Adresses des relais placés devant Caddy (CIDR séparés par des espaces), seules crues sur
# X-Forwarded-For. Vide = aucun relais : Caddy voit directement les visiteurs.
TRUSTED_PROXIES=
# En-tête de politique de sécurité de contenu. Commencer en observation (aucun blocage), vérifier
# la console du navigateur sur chaque surface, puis passer à `Content-Security-Policy`.
CSP_HEADER=Content-Security-Policy-Report-Only

# --- Secrets ---------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# 32 caractères minimum, différent de la valeur de développement : sinon l'API refuse de démarrer.
JWT_SECRET=

# --- API (valeurs par défaut raisonnables) ---------------------------------------------------
# JWT_EXPIRES_IN=2h
# Taille maximale d'un extrait audio, en octets (défaut 10 Mio). Caddy accepte jusqu'à 12 Mo :
# relever aussi `max_size` dans le Caddyfile si on dépasse ce chiffre.
# MEDIA_MAX_BYTES=10485760
# Purge RGPD des e-mails de joueurs (heures ; 0 = désactivée).
# PLAYER_EMAIL_PURGE_INTERVAL_HOURS=24

# --- Premier superadmin ----------------------------------------------------------------------
# Lus UNIQUEMENT par `docker compose run --rm bootstrap-admin`, une seule fois à l'installation.
# Ensuite, SUPPRIMER ADMIN_SEED_PASSWORD de ce fichier : relancer la commande réécrit le mot de
# passe du superadmin. Mot de passe : 14 caractères minimum.
ADMIN_SEED_EMAIL=
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_COMPANY_NAME=
# ADMIN_SEED_COMPANY_EMAIL=

# --- Sauvegardes (restic) --------------------------------------------------------------------
# Dépôt distant, au choix selon l'hébergement du stockage :
#   s3:https://<hôte-du-stockage>/<bucket>/quizzup   (tout stockage compatible S3)
#   rest:https://<utilisateur>:<mot-de-passe>@<hôte>/quizzup   (restic rest-server)
# D'autres protocoles existent (SFTP, B2, Azure, rclone) : voir https://restic.readthedocs.io,
# puis ajouter leurs variables dans la section `environment` du service `restic` du compose.
RESTIC_REPOSITORY=
# Mot de passe de chiffrement du dépôt. À CONSERVER AUSSI HORS DE CE SERVEUR (gestionnaire de
# mots de passe) : sans lui, les sauvegardes sont illisibles, serveur perdu compris.
RESTIC_PASSWORD=
# Accès au stockage S3 (laisser vides pour un autre protocole).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# Rétention : jours, semaines, mois conservés.
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=12

# --- Supervision (check.sh) ------------------------------------------------------------------
# Alerte par webhook (Slack, Mattermost, Discord, ntfy… : corps JSON {"text":…,"content":…}).
ALERT_WEBHOOK_URL=
# Alerte par e-mail : demande la commande `mail` sur le serveur (paquet mailutils ou équivalent).
ALERT_EMAIL_TO=
# Dossier d'état des scripts (verrou, marqueur de dernière sauvegarde, anti-répétition des alertes,
# copie de base éphémère) : ./state par défaut. Lu dans l'ENVIRONNEMENT du script (ligne de crontab,
# `export`), pas dans ce fichier : le renseigner ici n'aurait aucun effet. Garder la même valeur
# pour tous les scripts, sinon le verrou ne les relie plus.
# QUIZZUP_STATE_DIR=/chemin/absolu
# Minutes avant de renvoyer une alerte identique.
# ALERT_REPEAT_MINUTES=60
# Seuils : occupation du disque (%), jours avant expiration d'un certificat, âge maximal de la
# dernière sauvegarde réussie (heures).
# DISK_WARN_PERCENT=85
# CERT_WARN_DAYS=14
# BACKUP_MAX_AGE_HOURS=26
