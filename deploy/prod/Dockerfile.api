# API de production : TypeScript compilé (`tsc`), lancé avec `node dist/server.js`, sans `tsx`.
# Contexte de build : la racine du dépôt (voir docker-compose.yml).
#
# Les dépendances de développement restent dans l'image : `knex` (client de base et migrations)
# est déclaré en devDependencies alors que l'API et les migrations en ont besoin à l'exécution.
# Le jour où il passe en dependencies, ajouter `npm prune --omit=dev` après le build.

FROM node:22-alpine

# Même arborescence que l'image de développement : le backend retrouve `../shared` et `../docs`.
WORKDIR /workspace

COPY backoffice/shared/package*.json shared/
RUN npm --prefix shared ci
COPY backoffice/shared shared
RUN npm --prefix shared run build

COPY backoffice/backend/package*.json backend/
RUN npm --prefix backend ci
COPY backoffice/backend backend
RUN npm --prefix backend run build

# L'API lit openapi.yaml (Swagger) et public-v1.yaml (contrat de l'API publique, servi par
# GET /public/v1/openapi.yaml) au démarrage : copiés dans l'image, pas montés.
COPY backoffice/docs/api/openapi.yaml backoffice/docs/api/public-v1.yaml docs/api/

# Dossier des médias : créé au bon propriétaire pour que le volume nommé en hérite.
RUN mkdir -p /data/media && chown node:node /data/media

ENV NODE_ENV=production
USER node
WORKDIR /workspace/backend
EXPOSE 3001
CMD ["node", "dist/server.js"]
