# Recette QuizzUP — copier en .env à côté de ce fichier puis remplir.

# Domaine racine. Sans nom de domaine : l'IP du serveur avec des tirets + .sslip.io
# (ex. IP 51.15.12.34 -> 51-15-12-34.sslip.io). Les 3 sites seront alors :
#   https://bo.<DOMAIN>  (backoffice)   https://salle.<DOMAIN>  (écran de salle)
#   https://api.<DOMAIN> (API)
DOMAIN=

# Email de contact Let's Encrypt (avertissements d'expiration des certificats).
ACME_EMAIL=

# Secrets OBLIGATOIRES (laissés vides ici : le démarrage est refusé tant qu'ils manquent).
# Générer des valeurs aléatoires en hexadécimal uniquement : `openssl rand -hex 32`
# (POSTGRES_PASSWORD entre tel quel dans une URL : pas de @ : / # ni d'espace).
POSTGRES_PASSWORD=
JWT_SECRET=

# Mot de passe de tous les comptes créés par les seeds (superadmin `admin`, `demo-admin`,
# `salle1-demo` et les comptes d'exemple des compagnies). Le changer ensuite dans le backoffice.
SEED_PASSWORD=
