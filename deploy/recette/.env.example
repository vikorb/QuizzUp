# Recette QuizzUP — copier en .env à côté de ce fichier puis remplir.

# Domaine racine. Sans nom de domaine : l'IP du serveur avec des tirets + .sslip.io
# (ex. IP 51.15.12.34 -> 51-15-12-34.sslip.io). Les 3 sites seront alors :
#   https://bo.<DOMAIN>  (backoffice)   https://salle.<DOMAIN>  (écran de salle)
#   https://api.<DOMAIN> (API)
DOMAIN=

# Email de contact Let's Encrypt (avertissements d'expiration des certificats).
ACME_EMAIL=

# Secrets OBLIGATOIRES (laissés vides ici : le démarrage est refusé tant qu'ils manquent).
# Générer des valeurs aléatoires en hexadécimal uniquement : `openssl rand -hex 32`
# (POSTGRES_PASSWORD entre tel quel dans une URL : pas de @ : / # ni d'espace).
POSTGRES_PASSWORD=
JWT_SECRET=

# Mot de passe de tous les comptes créés par les seeds (superadmin `admin`, `demo-admin`,
# `salle1-demo` et les comptes d'exemple des compagnies). Le changer ensuite dans le backoffice.
SEED_PASSWORD=

# Proxys de confiance pour l'API : le sous-réseau Docker où se trouve Caddy, fixé dans
# docker-compose.yml (réseau `default`). Sans lui, l'API voit l'adresse de Caddy pour tous les
# clients : limite de débit commune (connexion : 100 tentatives par 15 minutes pour tout le monde)
# et adresse de la console faussée. Ne le changer qu'avec le sous-réseau du compose.
# « true », « * » et 0.0.0.0/0 sont refusés au démarrage.
TRUST_PROXY=172.29.250.0/24

# Console éditeur : adresses d'où le compte superadmin peut se connecter et appeler l'API,
# séparées par des espaces (adresses ou plages CIDR, IPv4 et IPv6). OBLIGATOIRE pour utiliser le
# superadmin : vide = console fermée, aucun superadmin ne passe (connexion refusée comme un mauvais
# mot de passe, jeton déjà émis refusé en 403). SEULEMENT les postes des opérateurs (plage du VPN
# ou adresses /32), jamais le réseau Docker ni l'adresse du serveur : tout internet passerait.
# Exemple (adresses de documentation, à remplacer) : 192.0.2.10/32 2001:db8::/48
# Pour retrouver l'accès : ajouter l'adresse /32 du poste ici, puis relancer `up -d`.
CONSOLE_ALLOWED_CIDRS=

# Sites autorisés à appeler l'API publique /public/v1 depuis un navigateur (origines exactes
# séparées par des virgules). Vide = aucun.
VITRINE_ORIGINS=
