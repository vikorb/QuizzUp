# Recette QuizzUP — copier en .env à côté de ce fichier puis remplir.

# Domaine racine. Sans nom de domaine : l'IP du serveur avec des tirets + .sslip.io
# (ex. IP 51.15.12.34 -> 51-15-12-34.sslip.io). Les 3 sites seront alors :
#   https://bo.<DOMAIN>  (backoffice)   https://salle.<DOMAIN>  (écran de salle)
#   https://api.<DOMAIN> (API)
DOMAIN=51-15-12-34.sslip.io

# Email de contact Let's Encrypt (avertissements d'expiration des certificats).
ACME_EMAIL=ops@example.com

# Secrets : générer des valeurs longues et aléatoires (ex. `openssl rand -hex 32`).
POSTGRES_PASSWORD=a_changer
JWT_SECRET=a_changer

# Mot de passe des comptes du seed (superadmin `admin`, `demo-admin`, `salle1-demo`).
SEED_PASSWORD=a_changer
