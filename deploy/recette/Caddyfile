# Trois sous-domaines, certificats HTTPS obtenus automatiquement par Caddy.
# DOMAIN vient du fichier .env (ex. 51-15-12-34.sslip.io : aucun nom de domaine à acheter).
{
	email {$ACME_EMAIL}
}

api.{$DOMAIN} {
	# Flux SSE (US-LIVE-01) : ni compression ni tampon, sinon les événements n'arrivent pas en direct.
	@sse path /room/stream /companies/*/live
	handle @sse {
		reverse_proxy backend:3001 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy backend:3001
	}
}

bo.{$DOMAIN} {
	encode gzip
	root * /srv/backoffice
	try_files {path} /index.html
	file_server
}

salle.{$DOMAIN} {
	encode gzip
	root * /srv/salle
	try_files {path} /index.html
	file_server
}
