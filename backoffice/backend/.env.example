# Database
DATABASE_URL=postgresql://quizzup:quizzup@localhost:5434/quizzup_backoffice

# Seed - Company
QUIZZUP_COMPANY_EMAIL=billing@quizzup.local

# Seed - Admin
ADMIN_SEED_EMAIL=admin@quizzup.local
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe123!

# Seed - Démo (compagnie « QuizzUP Démo », demo-admin, salle1-demo, 2 thèmes blind test)
# DEMO_SEED=false pour ne pas le créer ; mot de passe des deux comptes de démo.
DEMO_SEED=true
DEMO_SEED_PASSWORD=Demo1234!

# Démarrage Docker (npm run seed:if-empty) : `if-empty` = tous les seeds sur une base vide,
# sinon seulement le seed de démo ; `always` = tous les seeds à chaque démarrage (vide le contenu
# et l'historique des parties).
SEED_ON_START=if-empty

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:4173,http://localhost:4174

# JWT
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=2h

# Stockage média (extraits audio des questions)
# Dossier des fichiers (volume Docker en prod). Défaut : ./storage/media
MEDIA_STORAGE_DIR=./storage/media
# Taille max d'un fichier, en octets (défaut 10 Mo)
MEDIA_MAX_BYTES=10485760

# RGPD : purge des emails joueurs conservés plus de 3 ans après leur dernière partie.
# Fréquence en heures (défaut 24) ; 0 = purge automatique désactivée.
# Purge manuelle : `npm run purge:emails` (depuis backoffice/backend).
PLAYER_EMAIL_PURGE_INTERVAL_HOURS=24
