# Database
DATABASE_URL=postgresql://quizzup:quizzup@localhost:5434/quizzup_backoffice

# Seed - Company
QUIZZUP_COMPANY_EMAIL=billing@quizzup.local

# Seed - Admin
ADMIN_SEED_EMAIL=admin@quizzup.local
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe123!

# Seed - Démo (compagnie « QuizzUP Démo », demo-admin, salle1-demo, 2 thèmes blind test)
# DEMO_SEED=false pour ne pas le créer ; mot de passe des deux comptes de démo.
DEMO_SEED=true
DEMO_SEED_PASSWORD=Demo1234!

# Démarrage Docker (npm run seed:if-empty) : `if-empty` = tous les seeds sur une base vide,
# sinon seulement le seed de démo ; `always` = tous les seeds à chaque démarrage (vide le contenu
# et l'historique des parties).
SEED_ON_START=if-empty

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:4173,http://localhost:4174

# Proxys de confiance : adresses ou plages CIDR séparées par des virgules, ex. le sous-réseau Docker
# de Caddy (172.18.0.0/16). Le backend lit alors l'adresse du client dans X-Forwarded-For ; elle sert
# aux limites de débit (connexion, API publique). Vide = adresse de la connexion directe, ce qui
# convient en local. Derrière un proxy, vide = tous les clients partagent l'adresse du proxy.
# « true », « * » et les plages trop larges (au-dessus de /8 en IPv4, de /16 en IPv6, ou qui
# contiennent ::ffff:0:0/96) sont refusées au démarrage : le client pourrait forger son adresse.
# Les adresses avec zone (fe80::1%eth0) sont refusées aussi. Réglé, il fait entrer l'adresse réelle
# des clients dans les journaux : les conserver 30 jours au plus.
TRUST_PROXY=

# Console éditeur : adresses ou plages CIDR (IPv4 et IPv6) d'où le compte superadmin peut se
# connecter et appeler l'API, séparées par des espaces (format de Caddy, qui lit la même variable ;
# le backend accepte aussi les virgules). Hors de ces adresses : 401 à la connexion, 403 ensuite.
# Vide ou absente = aucune adresse, tout superadmin est refusé (console fermée). Une entrée
# invalide empêche le démarrage. Valeur de développement : la machine locale seulement.
# En recette et en production : SEULEMENT les postes des opérateurs (plage du VPN ou adresses /32),
# jamais une plage qui contient l'adresse du proxy (Caddy) ou du réseau Docker : tout internet
# passerait. Se règle avec TRUST_PROXY : l'adresse lue est celle que Fastify calcule avec lui.
CONSOLE_ALLOWED_CIDRS=127.0.0.1/32 ::1/128

# Double authentification (TOTP) du superadmin. Clé de chiffrement des secrets en base : 32 octets
# en base64 (`openssl rand -base64 32`), distincte de JWT_SECRET, jamais dans le dépôt, sauvegardée
# à part (gestionnaire de mots de passe) : sans elle, les secrets enregistrés sont inutilisables
# (`npm run totp:reset -- --username <x>` les efface). Absente ou invalide : la connexion superadmin
# répond 503 `totp_unavailable` ; le reste de l'API fonctionne.
TOTP_ENCRYPTION_KEY=
# Nom affiché dans l'application d'authentification (défaut QuizzUp).
TOTP_ISSUER=

# API publique /public/v1 (vitrine, réservation) : sites autorisés à l'appeler depuis un navigateur,
# origines exactes séparées par des virgules (ex. https://quizzup.fr,https://www.quizzup.fr).
# Vide = aucune origine (appels de serveur à serveur seulement). Indépendant de CORS_ORIGIN.
VITRINE_ORIGINS=

# URL publique du backoffice, sans « / » final (ex. https://bo.quizzup.fr). Prévue pour les liens et
# QR codes envoyés aux joueurs (inscription par QR, bons) : aucune fonctionnalité ne la lit encore.
PUBLIC_APP_URL=

# JWT
# Valeur de développement. Avec NODE_ENV=production, l'API refuse de démarrer si le secret
# fait moins de 32 caractères ou vaut cette valeur (en générer un : `openssl rand -hex 32`).
# Le déploiement de production (deploy/prod) fixe NODE_ENV=production lui-même.
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=2h

# Stockage média (extraits audio des questions)
# Dossier des fichiers (volume Docker en prod). Défaut : ./storage/media
MEDIA_STORAGE_DIR=./storage/media
# Taille max d'un fichier, en octets (défaut 10 Mo)
MEDIA_MAX_BYTES=10485760

# RGPD : purge des emails joueurs conservés plus de 3 ans après leur dernière partie
# dans la compagnie (centre) concernée, et des demandes de démonstration de plus de 12 mois.
# Cette variable règle la fréquence de toutes les purges RGPD, en heures (défaut 24, minimum 1 :
# une valeur plus petite est remplacée par 24) ; 0 = purges automatiques désactivées.
# Purge manuelle des emails joueurs : `npm run purge:emails` (depuis backoffice/backend).
PLAYER_EMAIL_PURGE_INTERVAL_HOURS=24

# Journaux d'erreurs des salles (POST /room/logs) : durée de conservation en jours (défaut 30).
# Une valeur absente, invalide, inférieure à 1 ou supérieure à 3650 (10 ans) est remplacée par 30. Le
# nettoyage a lieu à chaque envoi d'une salle (au plus 5000 lignes par salle en plus). Les adresses
# e-mail y sont masquées et le contexte limité à une liste de clés, mais les messages restent du
# texte libre : ne pas les traiter comme exempts de toute donnée personnelle.
ROOM_LOG_RETENTION_DAYS=30
