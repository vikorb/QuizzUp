{
  "name": "@quizzup/vitrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site vitrine public QuizzUp : pages HTML statiques (Vite multi-pages), un seul petit script pour le formulaire de démonstration. Le résultat de la construction est un dossier de fichiers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@types/node": "^24.19.2",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "~17.8.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.3.1",
    "prettier": "~3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.65.0",
    "vite": "^7.3.1",
    "vitest": "~4.1.10"
  }
}
