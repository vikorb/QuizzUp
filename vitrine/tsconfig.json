{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@quizzup/shared": ["../backoffice/shared/src/index.ts"]
    }
  },
  "include": ["site.config.ts", "vite.config.ts", "vitest.config.ts", "build", "src", "tests"]
}
