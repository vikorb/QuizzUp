{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@quizzup/shared": ["../../backoffice/shared/src/index.ts"],
      "@engine/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
