{
  "name": "@quizzup/artnet-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pont local facultatif QuizzUp : reçoit les trames DMX de l'écran de salle (WebSocket sur 127.0.0.1) et les envoie en Art-Net (UDP). Aucune dépendance d'exécution.",
  "bin": {
    "quizzup-artnet-bridge": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:sea": "node scripts/build-sea.mjs",
    "smoke:sea": "node scripts/smoke-bridge.mjs dist-sea/quizzup-artnet-bridge",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "~17.8.0",
    "lint-staged": "^16.3.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "~3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.65.0",
    "vitest": "~4.1.10"
  }
}
