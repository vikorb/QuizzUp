{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@quizzup/game-engine": ["../engine/src/index.ts"],
      "@quizzup/audio": ["../audio/src/index.ts"],
      "@quizzup/hardware": ["../hardware/src/index.ts"],
      "@quizzup/shared": ["../../backoffice/shared/src/index.ts"],
      "@room-app/*": ["../room-app/src/*"],
      "@/*": ["../room-app/src/*"]
    }
  },
  "include": ["playwright.config.ts", "harness", "tests"]
}
